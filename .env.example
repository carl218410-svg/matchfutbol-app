# Copia este archivo a .env para desarrollo local, o configura estas
# mismas variables en tu proveedor de hosting (Railway, Render, Fly.io...).
# NUNCA subas el archivo .env real a un repositorio.

# Clave usada por Flask para firmar la sesion (cookies de login). Genera
# una propia con: python -c "import secrets; print(secrets.token_hex(32))"
MATCHFUTBOL_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Password del panel /admin/login. Cambialo antes de lanzar a producción.
MATCHFUTBOL_ADMIN_PASSWORD=cambia-este-password-de-admin

# Ruta del archivo SQLite. Solo necesario en producción si tu hosting borra
# el disco en cada redeploy (Railway, Render...): monta un volumen
# persistente y apunta esta variable a un archivo dentro de ese volumen,
# por ejemplo /data/matchfutbol.db. Si no la defines, se usa el archivo
# local junto a app.py (correcto para desarrollo).
# MATCHFUTBOL_DB_PATH=/data/matchfutbol.db

# Login con Google (opcional). Se generan en Google Cloud Console ->
# "Google Auth platform" -> "Clients" -> Create Client -> Web application.
# En "Authorized redirect URIs" agrega <tu-url>/auth/google/callback.
# Si dejas estas dos variables vacías, el botón "Continuar con Google"
# simplemente no aparece y el login por correo/contraseña sigue funcionando.
# MATCHFUTBOL_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
# MATCHFUTBOL_GOOGLE_CLIENT_SECRET=tu-client-secret
